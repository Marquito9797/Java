import java.util.Scanner;
public class Conta {
    public static void main(String[] args) {
        // Criando o objeto Scanner para receber entradas do usuário
        Scanner scanner = new Scanner(System.in);

        // Lê os dados necessários para criar a conta
        System.out.println("Bem-vindo ao Banco Javinha! Vamos criar sua conta.");
        System.out.println("Por favor, digite o número da Conta:");
        int numero = scanner.nextInt();
        scanner.nextLine(); 

        System.out.println("Por favor, digite o número da Agência:");
        String agencia = scanner.nextLine();

        System.out.println("Por favor, digite o seu Nome:");
        String nomeCliente = scanner.nextLine();

        System.out.println("Por favor, digite o saldo de milhões:");
        double saldo = scanner.nextDouble();

        // Mensagem de confirmação
        System.out.println("\nOlá " + nomeCliente + ", obrigado por criar uma conta no Banco Javinha, sua agência é " 
            + agencia + ", conta " + numero + " e seu saldo de " + saldo + " milhões já está disponível para saque.");
        
        scanner.close();
    }
}
